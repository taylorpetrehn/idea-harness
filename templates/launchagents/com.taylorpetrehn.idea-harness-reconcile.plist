<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.taylorpetrehn.idea-harness-reconcile</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/taylorpetrehn/.local/bin/python3</string>
    <string>/Users/taylorpetrehn/.claude/skills/idea-harness/scripts/reconcile.py</string>
  </array>

  <!-- Every 5 minutes. Matches the Phase-4 reconcile cadence in the
       bridge plan. Short enough that GH-Action / Codespace builds get
       ingested promptly; long enough that we don't beat `gh api` to
       death. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/taylorpetrehn/.claude/skills/idea-harness/logs/reconcile.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/taylorpetrehn/.claude/skills/idea-harness/logs/reconcile.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
