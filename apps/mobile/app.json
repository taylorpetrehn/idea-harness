{
  "expo": {
    "name": "Idea Harness",
    "slug": "idea-harness-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "idea-harness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taylorpetrehn.ideaharness",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.taylorpetrehn.ideaharness"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de4bd05f-2a20-4cf8-8744-2131d142cab8"
      }
    },
    "owner": "taylorpetrehn"
  }
}
