{
  "expo": {
    "name": "Idea Harness",
    "slug": "idea-harness-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "idea-harness",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taylorpetrehn.ideaharness"
    },
    "android": {
      "package": "com.taylorpetrehn.ideaharness"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
